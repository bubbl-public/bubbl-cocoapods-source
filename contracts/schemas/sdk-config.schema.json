{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bubbl.tech/sdk/v3/sdk-config.schema.json",
  "title": "BubblSdkConfig",
  "type": "object",
  "required": ["apiKey"],
  "properties": {
    "apiKey": { "type": "string" },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "transmissionBaseUrl": { "type": ["string", "null"] },
    "runtimeBaseUrl": {
      "type": ["string", "null"],
      "description": "Backward-compatible alias for transmissionBaseUrl."
    },
    "ingestBaseUrl": { "type": ["string", "null"] },
    "segments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "correlationId": { "type": ["string", "null"] },
    "defaultDistanceMeters": {
      "type": "integer",
      "minimum": 1,
      "description": "Public SDK distance in meters. Native clients convert this to the current Transmission v2 wire unit for legacy runtime compatibility."
    },
    "refreshIntervalSeconds": {
      "type": "integer",
      "minimum": 60
    },
    "enablePushHandling": { "type": "boolean" },
    "enableLocationTracking": { "type": "boolean" },
    "logLevel": {
      "type": "string",
      "enum": ["off", "error", "warn", "info", "debug"]
    }
  },
  "additionalProperties": false
}
