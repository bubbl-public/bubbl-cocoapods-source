{
  "contractVersion": "4.0.0",
  "environments": {
    "development": {
      "platformApiBaseUrl": "https://staging.api.bubbl.tech",
      "transmissionBaseUrl": "https://staging.transmission.bubbl.tech",
      "runtimeBaseUrl": "https://staging.transmission.bubbl.tech",
      "ingestBaseUrl": "https://staging.ingest.bubbl.tech",
      "legacyAlias": "staging"
    },
    "staging": {
      "platformApiBaseUrl": "https://staging.api.bubbl.tech",
      "transmissionBaseUrl": "https://staging.transmission.bubbl.tech",
      "runtimeBaseUrl": "https://staging.transmission.bubbl.tech",
      "ingestBaseUrl": "https://staging.ingest.bubbl.tech"
    },
    "production": {
      "platformApiBaseUrl": "https://api.bubbl.tech",
      "transmissionBaseUrl": "https://transmission.bubbl.tech",
      "runtimeBaseUrl": "https://transmission.bubbl.tech",
      "ingestBaseUrl": "https://ingest.bubbl.tech"
    }
  },
  "runtime": {
    "refreshGeofence": {
      "method": "POST",
      "path": "/api/check-geofence",
      "authHeader": "x-api-key",
      "owner": "transmission",
      "publicDistanceUnit": "meters",
      "wireDistanceUnit": "miles",
      "wireShape": "legacy-transmission-v2"
    },
    "refreshPush": {
      "method": "GET",
      "path": "/api/check-push",
      "authHeader": "x-api-key",
      "owner": "transmission"
    },
    "getConfiguration": {
      "method": "GET",
      "path": "/api/get-config",
      "authHeader": "x-api-key",
      "owner": "transmission"
    }
  },
  "ingest": {
    "registerDevice": {
      "method": "POST",
      "path": "/api/device-registerd/create",
      "authHeader": "ApiKey",
      "owner": "ingest",
      "wireShape": "legacy-mirrored"
    },
    "bootBatch": {
      "method": "POST",
      "path": "/api/device-data",
      "authHeader": "ApiKey",
      "owner": "ingest",
      "wireShape": "legacy-mirrored"
    },
    "trackEvent": {
      "method": "POST",
      "path": "/api/activities",
      "authHeader": "ApiKey",
      "owner": "ingest",
      "wireShape": "legacy-mirrored"
    },
    "updateSegments": {
      "method": "POST",
      "path": "/api/segments",
      "authHeader": "ApiKey",
      "owner": "ingest",
      "wireShape": "legacy-mirrored"
    },
    "submitSurveyResponse": {
      "method": "POST",
      "path": "/api/survey-response",
      "authHeader": "ApiKey",
      "owner": "ingest",
      "wireShape": "legacy-mirrored"
    },
    "trackGeofenceBatch": {
      "method": "POST",
      "path": "/api/geofence-data",
      "authHeader": "ApiKey",
      "owner": "ingest",
      "wireShape": "legacy-mirrored"
    }
  },
  "headers": {
    "diagnostic": [
      "X-Bubbl-SDK-Version",
      "X-Bubbl-SDK-Platform",
      "X-Bubbl-Request-ID",
      "X-Bubbl-Install-ID"
    ],
    "idempotency": [
      "Idempotency-Key",
      "X-Idempotency-Key"
    ]
  }
}
